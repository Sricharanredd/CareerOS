# ---- Application ----------------------------------------------------------
CAREEROS_ENV=development
APP_NAME=CareerOS
SECRET_KEY=change-me-to-64-random-characters
LOG_LEVEL=INFO

# ---- Database (MySQL 8.0 only, PyMySQL driver) ---------------------------
DATABASE_URL=mysql+pymysql://careeros_app:CHANGE_ME@127.0.0.1:3306/careeros?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://careeros_app:CHANGE_ME@127.0.0.1:3306/careeros_test?charset=utf8mb4

# ---- Auth ---------------------------------------------------------------
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# ---- HTTP ---------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Storage ------------------------------------------------------------
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=5242880

# ---- AI provider (analyzer) ---------------------------------------------
# Cloudflare Workers AI is the only privacy-approved provider. Free-only, no paid fallback.
AI_PROVIDER_ORDER=cloudflare
AI_APPROVED_PROVIDERS=cloudflare
AI_FREE_ONLY=true
AI_ALLOW_TRAINING_PROVIDERS=false
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# Legacy adapter: excluded from resume analysis unless explicitly approved and waived.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

AI_TIMEOUT_SECONDS=90
PROMPT_VERSION=analysis-v1
